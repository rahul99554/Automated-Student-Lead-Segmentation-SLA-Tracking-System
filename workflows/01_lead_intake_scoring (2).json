    {
      "parameters": {
        "jsCode": "const j = $json;\nconst near = j.start_months <= 3;\nconst hasExp = j.experience_level !== 'Complete Beginner';\n\nconst priority = near ? (hasExp ? 'HOT' : 'WARM') : 'COLD';\nconst sla = priority === 'HOT' ? 5 : priority === 'WARM' ? 30 : '';\n\nconst reason = `Starts: ${j.start_timeline}; experience: ${j.experience_level}; rule result: ${priority}`;\n\nreturn { json: {\n  lead_id: j.lead_id,\n  submitted_at: j.submitted_at,\n  name: j.name,\n  email: j.email,\n  phone: j.phone,\n  course: j.course,\n  learning_mode: j.learning_mode,\n  experience_level: j.experience_level,\n  start_timeline: j.start_timeline,\n  source: j.source,\n  notes: j.notes,\n  status: 'New',\n  priority,\n  ai_reason: reason,\n  assigned_to: '',\n  sla_limit_min: sla,\n  alert_sent_at: priority === 'COLD' ? '' : new Date().toISOString(),\n  first_contact_at: '',\n  duplicate_count: 0,\n  last_seen_at: j.submitted_at\n}};"
      },
