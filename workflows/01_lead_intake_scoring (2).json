    {
      "parameters": {
        "jsCode": "const DAY = 24 * 60 * 60 * 1000;\n\n// latest activity per email already stored in the Leads tab\nconst lastSeen = {};\nfor (const r of $input.all()) {\n  const e = String(r.json.email || '').toLowerCase();\n  if (!e) continue;\n  const t = Date.parse(r.json.last_seen_at || r.json.submitted_at);\n  if (!isNaN(t)) lastSeen[e] = Math.max(lastSeen[e] || 0, t);\n}\n\n// valid leads from the TRUE branch of Is Valid\nconst leads = $('Is Valid').all(0);\n\nreturn leads.map(l => {\n  const e = String(l.json.email).toLowerCase();\n  const t = Date.parse(l.json.submitted_at);\n  const prev = lastSeen[e];\n  const is_duplicate = prev !== undefined && (t - prev) <= 30 * DAY;\n  lastSeen[e] = Math.max(prev || 0, t);   // also catches repeats inside the same batch\n  return { json: { ...l.json, is_duplicate } };\n});"
      },
      "type": "n8n-nodes-base.code",
