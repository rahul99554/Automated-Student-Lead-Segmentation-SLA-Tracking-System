    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\n// find a column by partial header text, so small title edits don't break the flow\nconst get = (key) => {\n  const k = Object.keys(j).find(c => c.toLowerCase().includes(key));\n  return k ? String(j[k] ?? '').trim() : '';\n};\n\nconst name  = get('full name');\nconst email = get('email').toLowerCase();\nconst phone = get('phone').replace(/[\\s\\-+]/g, '').replace(/^91(?=\\d{10}$)/, '');\nconst notes = get('additional');\nconst mode  = get('mode of learning');\nconst source = get('hear about us');\n\n// course -> canonical value\nconst c = get('which course').toLowerCase();\nconst course = c.includes('web') ? 'Web Development Bootcamp'\n  : c.includes('data science') ? 'Data Science and Machine Learning'\n  : c.includes('business') ? 'Business Analytics'\n  : c.includes('ai engineer') ? 'AI Engineer' : '';\n\n// experience -> canonical value\nconst e = get('level of experience').toLowerCase();\nconst experience = e.includes('beginner') ? 'Complete Beginner'\n  : e.includes('basic') ? 'Some Basic Knowledge'\n  : e.includes('intermediate') ? 'Intermediate'\n  : e.includes('advanced') ? 'Advanced' : '';\n\n// start timeline -> months (4 = more than 3, 99 = just exploring)\nconst s = get('planning to start').toLowerCase();\nconst m = s.match(/within\\s+(\\d)\\s+month/);\nconst startMonths = m ? parseInt(m[1]) : s.includes('more than') ? 4 : s.includes('explor') ? 99 : null;\nconst startLabel = startMonths === null ? '' : startMonths <= 3 ? `Within ${startMonths} Month${startMonths > 1 ? 's' : ''}`\n  : startMonths === 4 ? 'More Than 3 Months' : 'Just Exploring';\n\n// timestamp: handles month/day/year (US sheet) and day/month/year (first number > 12)\n// stored as local IST time with an explicit +05:30 offset\nconst pad = (n) => String(n).padStart(2, '0');\nconst p = get('timestamp').match(/(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})\\s+(\\d{1,2}):(\\d{2}):(\\d{2})/);\nlet submitted_at = new Date().toISOString();\nif (p) {\n  const a = +p[1], b = +p[2];\n  const day = a > 12 ? a : b;\n  const month = a > 12 ? b : a;\n  submitted_at = `${p[3]}-${pad(month)}-${pad(day)}T${pad(p[4])}:${p[5]}:${p[6]}+05:30`;\n}\n\n// validation\nconst errors = [];\nif (!name) errors.push('missing name');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) errors.push('invalid email');\nif (!/^[6-9]\\d{9}$/.test(phone)) errors.push('invalid phone');\nif (!course) errors.push('unknown course');\nif (!experience) errors.push('unknown experience');\nif (startMonths === null) errors.push('unknown start timeline');\n\nreturn { json: {\n  lead_id: 'LD-' + Date.now().toString(36).toUpperCase() + '-' + $itemIndex,\n  submitted_at, name, email, phone, course,\n  learning_mode: mode, experience_level: experience,\n  start_timeline: startLabel, start_months: startMonths,\n  source, notes,\n  is_valid: errors.length === 0,\n  validation_errors: errors.join('; ')\n}};"
      },
